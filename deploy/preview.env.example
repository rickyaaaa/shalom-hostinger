# WORDPRESS_* are server-only. Keep site/API origins aligned at build and runtime.
# Backend hostname changes require a rebuild/redeploy for the image allowlist.
# Template only: replace the example frontend origin with the assigned HTTPS preview.
# Load the same values for build and runtime. Never deploy .env.local from this PC.
NODE_ENV=production
APP_URL=https://preview-hostname.example
PUBLIC_SITE_URL=https://preview-hostname.example
WORDPRESS_SITE_URL=https://slategray-goshawk-210407.hostingersite.com
WORDPRESS_API_URL=https://slategray-goshawk-210407.hostingersite.com/wp-json/shalom/v1
ALLOW_INDEXING=false
# Set through the hosting secret store: 32 cryptographically random bytes / 64 hex chars.
SESSION_ENCRYPTION_KEY=
# Hosting-supplied port, when applicable; not a browser environment variable.
PORT=3000

# Preview only: set the same independent random 64-hex key in WordPress server config.
HEADLESS_RATE_LIMIT_MODE=signed
SHALOM_HEADLESS_SIGNING_KEY=
