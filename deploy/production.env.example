# WORDPRESS_* are server-only. Keep site/API origins aligned at build and runtime.
# Backend hostname changes require a rebuild/redeploy for the image allowlist.
# Future deployment template ONLY. No DNS/WordPress/traffic change has been made.
NODE_ENV=production
APP_URL=https://shalombalitour.com
PUBLIC_SITE_URL=https://shalombalitour.com
WORDPRESS_SITE_URL=https://cms.shalombalitour.com
WORDPRESS_API_URL=https://cms.shalombalitour.com/wp-json/shalom/v1
# Remain false during preflight; switch true and rebuild ONLY at approved cutover.
ALLOW_INDEXING=false
# Use a distinct production secret, stable across all production instances/releases.
SESSION_ENCRYPTION_KEY=
PORT=3000
