# Next.js staging environment — multi-currency rc1.
# Preview scope only. Copy into the Vercel project's Preview environment.
# Never use production values; never add a NEXT_PUBLIC_ secret.

NODE_ENV=production

# Replace with the staging preview host (Vercel-protected). APP_URL and
# PUBLIC_SITE_URL must share the same origin. On Vercel Preview the app derives
# its public origins from VERCEL_URL, so keep this aligned with the project host.
APP_URL=https://shalom-multicurrency-staging.example.vercel.app
PUBLIC_SITE_URL=https://shalom-multicurrency-staging.example.vercel.app

# NEW isolated WordPress (temporary Hostinger domain or approved staging subdomain).
# Must be HTTPS, origin without subpath; API must be <origin>/wp-json/shalom/v1
WORDPRESS_SITE_URL=https://STAGING-WORDPRESS-HOST
WORDPRESS_API_URL=https://STAGING-WORDPRESS-HOST/wp-json/shalom/v1

# Staging must never be indexed.
ALLOW_INDEXING=false

# Generate fresh on the staging host: openssl rand -hex 32
# Never reuse the production key. Must differ from SESSION_ENCRYPTION_KEY.
SESSION_ENCRYPTION_KEY=
SHALOM_HEADLESS_SIGNING_KEY=
HEADLESS_RATE_LIMIT_MODE=signed
