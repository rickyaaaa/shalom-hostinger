# Staging-only configuration for the v1.29.0 multi-currency integration.
#
# TEMPLATE ONLY. Nothing here is deployed and no value below is a real secret.
# Copy to `.env.local` (local) or paste into the staging host's environment panel.
# NEVER point this file at cms.shalombalitour.com or at production.

NODE_ENV=production

# Isolated staging frontend (private preview host; not the production domain).
APP_URL=https://staging-multicurrency.example.test
PUBLIC_SITE_URL=https://staging-multicurrency.example.test

# Separate WordPress installation running the CORRECTED 1.29.0 plugin
# (see SHA-256 below). Must be its own database.
WORDPRESS_SITE_URL=https://cms-staging-multicurrency.example.test
WORDPRESS_API_URL=https://cms-staging-multicurrency.example.test/wp-json/shalom/v1

# Staging must never be indexed.
ALLOW_INDEXING=false

# Staging-only secrets. Generate fresh values; never reuse production keys.
# openssl rand -hex 32
SESSION_ENCRYPTION_KEY=
HEADLESS_RATE_LIMIT_MODE=signed
# Must match the same independent key in the staging WordPress config.
SHALOM_HEADLESS_SIGNING_KEY=

PORT=3000
